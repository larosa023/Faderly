<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <AssemblyName>Faderly</AssemblyName>
    <RootNamespace>Faderly</RootNamespace>
    <StartupObject>Faderly.Program</StartupObject>
    <ApplicationIcon>Assets\Faderly.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Bump this and push to main to publish a new release + auto-update -->
    <Version>0.3.0</Version>
    <Product>Faderly</Product>
    <Description>A clean, modern volume mixer for Windows.</Description>
    <Copyright>Copyright © 2026 Anthony</Copyright>

    <!-- Lightweight: English-only framework resources (drops ~a dozen localized folders),
         no background GC thread, and the debug info embedded so crash logs keep line numbers. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Faderly.png" />
  </ItemGroup>

</Project>
