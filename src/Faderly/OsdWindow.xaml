<Window x:Class="Faderly.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Faderly indicator"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="10">
        <!-- Soft painted shadow (no blur effect, so it costs nothing to draw) -->
        <Border CornerRadius="16" Background="#26000000" Margin="-2,1,-2,-4" />
        <Border CornerRadius="14" Background="{DynamicResource WindowBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Padding="14,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="28" Height="28" VerticalAlignment="Center">
                    <TextBlock x:Name="GlyphText" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}" />
                    <Image x:Name="IconImage" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Grid x:Name="Bar" Height="4" Margin="0,7,0,1">
                        <Border CornerRadius="2" Background="{DynamicResource TrackBrush}" />
                        <Border x:Name="BarFill" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BarScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="RightText" Grid.Column="2" VerticalAlignment="Center" MinWidth="36"
                           TextAlignment="Right" Foreground="{DynamicResource SubtextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
