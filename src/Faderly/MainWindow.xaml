<Window x:Class="Faderly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Faderly"
        Title="Faderly"
        Width="396"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="{DynamicResource TextBrush}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
        <local:MuteGlyphConverter x:Key="MuteGlyph" />
        <local:InverseBoolConverter x:Key="Not" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- ===== Buttons ===== -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="Padding" Value="14,7" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Fader slider ===== -->
        <Style x:Key="TrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrackEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thumb uses a painted soft shadow instead of a DropShadowEffect: same look, no per-frame shader work. -->
        <Style x:Key="FaderThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="18" Height="18" Background="Transparent">
                            <Ellipse Margin="-1,0,-1,-2" Fill="#1F000000" />
                            <Ellipse Margin="0,0,0,-1" Fill="#14000000" />
                            <Ellipse Fill="{DynamicResource ThumbBrush}"
                                     Stroke="{DynamicResource ThumbBorderBrush}" StrokeThickness="1" />
                            <Ellipse x:Name="Dot" Width="8" Height="8"
                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="10" />
                                <Setter TargetName="Dot" Property="Height" Value="10" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="6" />
                                <Setter TargetName="Dot" Property="Height" Value="6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Fader" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="SmallChange" Value="2" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <EventSetter Event="PreviewMouseWheel" Handler="Slider_PreviewMouseWheel" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource TrackBrush}" Margin="2,0" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackFill}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackEmpty}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FaderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Toggle switch (CheckBox) ===== -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="20" CornerRadius="10"
                                    Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left"
                                         Margin="3,0,0,0" Fill="{DynamicResource SubtextBrush}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Slim scrollbar ===== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="{DynamicResource ScrollThumbBrush}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- ===== Tray right-click menu (themed to match the app) ===== -->
        <ContextMenu x:Key="TrayMenu" Placement="MousePoint" HasDropShadow="False">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                        Padding="8,7,18,7" Margin="0,1" MinWidth="190">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource SubtextBrush}"
                                                   Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <TextBlock x:Name="Check" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource AccentBrush}" Text="&#xE73E;"
                                                   Visibility="Collapsed" />
                                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsCheckable" Value="True">
                                        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Border Height="1" Margin="8,4" Background="{DynamicResource BorderBrush}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="12">
                        <Border CornerRadius="10" Background="{DynamicResource WindowBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.3" />
                            </Border.Effect>
                            <Border.CacheMode>
                                <BitmapCache />
                            </Border.CacheMode>
                        </Border>
                        <Border CornerRadius="10" Background="{DynamicResource WindowBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="5">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </ContextMenu.Template>
            <MenuItem Header="Open Faderly" Tag="&#xE767;" Click="TrayOpen_Click" FontWeight="SemiBold" />
            <MenuItem Header="Sound settings" Tag="&#xE9E9;" Click="TraySound_Click" />
            <Separator />
            <MenuItem Header="Window mode" IsCheckable="True" IsChecked="{Binding IsWindowMode, Mode=TwoWay}"
                      Click="TrayWindowMode_Click" />
            <MenuItem Header="Start with Windows" IsCheckable="True" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
            <MenuItem Header="Check for updates" Tag="&#xE895;" Click="TrayUpdates_Click" />
            <Separator />
            <MenuItem Header="Quit" Tag="&#xE7E8;" Click="TrayQuit_Click" />
        </ContextMenu>
    </Window.Resources>

    <!-- 14px margin leaves room for the drop shadow -->
    <Grid x:Name="Shell" Margin="14">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ShellTranslate" />
        </Grid.RenderTransform>

        <!-- Shadow layer. Cached as a bitmap so the blur is drawn once, not every time a meter moves. -->
        <Border CornerRadius="14" Background="{DynamicResource WindowBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.35" />
            </Border.Effect>
            <Border.CacheMode>
                <BitmapCache />
            </Border.CacheMode>
        </Border>

        <Border CornerRadius="14" Background="{DynamicResource WindowBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14">
            <Grid>

                <!-- ==================== MIXER PAGE ==================== -->
                <DockPanel Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">

                    <!-- Header (also the drag handle in window mode) -->
                    <Grid DockPanel.Dock="Top" Margin="2,0,0,12" Background="Transparent"
                          MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/Faderly.png" Width="20" Height="20"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Faderly" Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Content="{Binding WindowModeGlyph}"
                                    ToolTip="{Binding WindowModeTip}" FontSize="14"
                                    Command="{Binding ToggleWindowModeCommand}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE9E9;" ToolTip="Windows sound settings"
                                    Command="{Binding OpenSoundSettingsCommand}" Margin="2,0,0,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings"
                                    Command="{Binding OpenSettingsCommand}" Margin="2,0,0,0" />
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsWindowMode, Converter={StaticResource BoolVis}}">
                                <Border Width="1" Height="18" Margin="6,0,4,0" Background="{DynamicResource BorderStrongBrush}" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimize"
                                        FontSize="11" Click="Minimize_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Close to tray"
                                        FontSize="11" Click="CloseToTray_Click" Margin="2,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Output device + master volume -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="6,6,6,10">
                        <StackPanel>
                            <Button Style="{StaticResource RowButton}" Command="{Binding ToggleDeviceListCommand}"
                                    ToolTip="Choose output device">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding DeviceGlyph}" FontSize="16"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Output" FontSize="11" Foreground="{DynamicResource SubtextBrush}" />
                                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="11"
                                               Foreground="{DynamicResource SubtextBrush}" Margin="8,0,2,0" />
                                </Grid>
                            </Button>

                            <!-- Device picker -->
                            <Border Visibility="{Binding IsDeviceListOpen, Converter={StaticResource BoolVis}}"
                                    Background="{DynamicResource Surface2Brush}" CornerRadius="8" Margin="4,4,4,6" Padding="4">
                                <ItemsControl ItemsSource="{Binding Devices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Padding="8,7"
                                                    Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14"
                                                               Foreground="{DynamicResource SubtextBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="12"
                                                               Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0"
                                                               Visibility="{Binding IsDefault, Converter={StaticResource BoolVis}}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <Grid Margin="6,4,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource IconButton}" Content="{Binding MasterGlyph}"
                                        Command="{Binding ToggleMasterMuteCommand}" ToolTip="Mute / unmute"
                                        FontSize="16" />
                                <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                    <Slider Value="{Binding MasterVolume, Mode=TwoWay}" IsEnabled="{Binding HasDevice}">
                                        <Slider.Style>
                                            <Style TargetType="Slider" BasedOn="{StaticResource Fader}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MasterMuted}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedFillBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Slider.Style>
                                    </Slider>
                                    <Rectangle Height="2" RadiusX="1" RadiusY="1" Margin="2,1,2,0"
                                               Fill="{DynamicResource MeterBrush}" RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding MasterPeak}" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding MasterVolumeText}" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Text="Apps" Style="{StaticResource SectionLabel}" Margin="4,16,0,6" />

                    <!-- Update banner (docked before the list so the list fills what's left) -->
                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" CornerRadius="10" Padding="12,10"
                            Background="{DynamicResource AccentSoftBrush}"
                            Visibility="{Binding Updater.UpdateReady, Converter={StaticResource BoolVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="16"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Update ready" FontWeight="SemiBold" />
                                <TextBlock Foreground="{DynamicResource SubtextBrush}" FontSize="12">
                                    <Run Text="Version " /><Run Text="{Binding Updater.AvailableVersion, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Restart"
                                    Command="{Binding RestartToUpdateCommand}" />
                        </Grid>
                    </Border>

                    <!-- App list (fills the remaining height, scrolls when needed) -->
                    <Grid>
                        <TextBlock Text="No apps are playing audio right now."
                                   Foreground="{DynamicResource SubtextBrush}" Margin="4,8,0,10"
                                   Visibility="{Binding HasApps, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />

                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasApps, Converter={StaticResource BoolVis}}">
                            <ItemsControl ItemsSource="{Binding Apps}" Margin="0,0,4,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,8,4,6" CornerRadius="10" Margin="0,0,0,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <!-- New rows fade in instead of popping -->
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0" To="1" Duration="0:0:0.18" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- App icon (or a letter / glyph fallback) -->
                                                <Grid Width="30" Height="30" VerticalAlignment="Center">
                                                    <Border CornerRadius="8" Background="{DynamicResource Surface2Brush}"
                                                            Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource SubtextBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding Initial}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                                            <Setter Property="Text" Value="&#xEA8F;" />
                                                                            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                                                                            <Setter Property="FontSize" Value="14" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <Image Source="{Binding Icon}" Width="26" Height="26"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}" />
                                                </Grid>

                                                <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center">
                                                    <Grid Margin="2,0,0,0">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,40,0" />
                                                        <TextBlock Text="{Binding VolumeText}" HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource SubtextBrush}" />
                                                    </Grid>
                                                    <Slider Value="{Binding Volume, Mode=TwoWay}" Margin="0,1,0,0">
                                                        <Slider.Style>
                                                            <Style TargetType="Slider" BasedOn="{StaticResource Fader}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedFillBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Slider.Style>
                                                    </Slider>
                                                    <Rectangle Height="2" RadiusX="1" RadiusY="1" Margin="2,0,2,0"
                                                               Fill="{DynamicResource MeterBrush}" Opacity="0.85"
                                                               RenderTransformOrigin="0,0.5">
                                                        <Rectangle.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding Peak}" />
                                                        </Rectangle.RenderTransform>
                                                    </Rectangle>
                                                </StackPanel>

                                                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                        Content="{Binding IsMuted, Converter={StaticResource MuteGlyph}}"
                                                        Command="{Binding ToggleMuteCommand}" ToolTip="Mute / unmute" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

                <!-- ==================== SETTINGS PAGE ==================== -->
                <DockPanel Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolVis}}">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12" Background="Transparent"
                          MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back"
                                    Command="{Binding CloseSettingsCommand}" />
                            <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding IsWindowMode, Converter={StaticResource BoolVis}}">
                            <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimize"
                                    FontSize="11" Click="Minimize_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Close to tray"
                                    FontSize="11" Click="CloseToTray_Click" Margin="2,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">

                    <TextBlock Text="Appearance" Style="{StaticResource SectionLabel}" Margin="4,0,0,6" />
                    <Border Style="{StaticResource Card}" Padding="10,10,10,4">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Themes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BaseButton}" Margin="3" Padding="0"
                                                HorizontalContentAlignment="Stretch" ToolTip="{Binding Name}"
                                                Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel>
                                                <Border Height="46" CornerRadius="8" BorderThickness="2"
                                                        Background="{Binding Background}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel VerticalAlignment="Center" Margin="9,0">
                                                        <Border Height="5" CornerRadius="2.5" Background="{Binding Surface}" Margin="0,0,18,0">
                                                            <Border Height="5" CornerRadius="2.5" Background="{Binding Accent}"
                                                                    HorizontalAlignment="Left" Width="30" />
                                                        </Border>
                                                        <Border Height="5" CornerRadius="2.5" Background="{Binding Surface}" Margin="0,6,8,0">
                                                            <Border Height="5" CornerRadius="2.5" Background="{Binding Meter}"
                                                                    HorizontalAlignment="Left" Width="18" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="12" Margin="2,5,0,4"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,8,4,0" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsWindowMode}" Margin="4,10">
                                <StackPanel>
                                    <TextBlock Text="Window mode" />
                                    <TextBlock Text="Use a regular app window instead of the tray popup" FontSize="12"
                                               TextWrapping="Wrap" Foreground="{DynamicResource SubtextBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="General" Style="{StaticResource SectionLabel}" Margin="4,16,0,6" />
                    <Border Style="{StaticResource Card}" Padding="14,4">
                        <StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" Margin="0,10">
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" />
                                    <TextBlock Text="Launch quietly in the tray when you sign in" FontSize="12"
                                               Foreground="{DynamicResource SubtextBrush}" />
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowSystemSounds}" Margin="0,10">
                                <TextBlock Text="Show system sounds" />
                            </CheckBox>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" />
                            <Grid Margin="0,12">
                                <TextBlock Text="Open Faderly" VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right" Background="{DynamicResource Surface2Brush}"
                                        CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="{Binding HotkeyText}" FontSize="12"
                                               Foreground="{DynamicResource SubtextBrush}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Updates" Style="{StaticResource SectionLabel}" Margin="4,16,0,6" />
                    <Border Style="{StaticResource Card}" Padding="14,4,14,14">
                        <StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoCheckUpdates}" Margin="0,10">
                                <StackPanel>
                                    <TextBlock Text="Update automatically" />
                                    <TextBlock Text="Download new versions in the background" FontSize="12"
                                               Foreground="{DynamicResource SubtextBrush}" />
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock>
                                        <Run Text="Faderly " /><Run Text="{Binding Updater.CurrentVersion, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Updater.Status}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SubtextBrush}" Margin="0,2,0,0"
                                               MaxWidth="200" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SoftButton}" Content="Check now"
                                            Command="{Binding CheckUpdatesCommand}"
                                            IsEnabled="{Binding Updater.IsBusy, Converter={StaticResource Not}}"
                                            Visibility="{Binding Updater.UpdateReady, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />
                                    <Button Style="{StaticResource AccentButton}" Content="Restart to update"
                                            Command="{Binding RestartToUpdateCommand}"
                                            Visibility="{Binding Updater.UpdateReady, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Button Style="{StaticResource SoftButton}" HorizontalAlignment="Left"
                                Command="{Binding OpenGitHubCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" FontSize="12" />
                                <TextBlock Text="GitHub" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SoftButton}" HorizontalAlignment="Right"
                                Command="{Binding QuitCommand}" Foreground="{DynamicResource DangerBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" FontSize="12" />
                                <TextBlock Text="Quit Faderly" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
